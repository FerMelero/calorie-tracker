# Reglas de EAS Build. Si existe este archivo, EAS lo usa EN LUGAR de .gitignore.
# Hay una copia idéntica en app/.easignore (según desde dónde se lance eas build);
# si cambias una, cambia la otra.

# --- Datos y bases de datos (se regeneran con el pipeline) ---
pipeline/data/
*.db
*.sqlite
*.sqlite3
*.csv
*.parquet
*.duckdb
*.gz

# --- Python ---
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/

# --- Node / Expo ---
node_modules/
.expo/
.expo-shared/
dist/
web-build/
npm-debug.*
yarn-error.log
*.tsbuildinfo

# --- Builds nativas ---
android/
ios/
*.apk
*.aab
*.ipa

# --- Credenciales y claves ---
.env
.env.*
!.env.example
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.pem

# --- Editor / SO ---
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
.DS_Store
Thumbs.db
*.log

# --- Solo para EAS Build ---
# La app no necesita el pipeline (ni sus volcados de 1,3 GB) para compilarse
pipeline/

# foods.db está ignorado por git pero la app lo necesita dentro de la APK.
# Esta línea debe ir la ÚLTIMA para que gane a las reglas anteriores.
!**/assets/db/foods.db
