{
  "expo": {
    "name": "Contador de Calorías",
    "slug": "contador-calorias",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "contadorcalorias",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.fernando.contadorcalorias"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#70E83D",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.fernando.contadorcalorias"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#70E83D",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200
        }
      ],
      "expo-sqlite",
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "adbe1f99-4f60-4edc-953a-0df3555f137b"
      }
    }
  }
}
