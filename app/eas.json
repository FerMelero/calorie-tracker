{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "autoIncrement": true,
      "env": {
        "BUILD_ARCHS": "arm64-v8a,armeabi-v7a"
      }
    },
    "production": {
      "autoIncrement": true
    },
    "preview-emulator": {
      "extends": "preview",
      "env": {
        "BUILD_ARCHS": "x86_64"
      }
    }
  }
}
